    {
      "film_id": "Queen Kelly|1932",
      "title": "Queen Kelly",
      "original_title": "Queen Kelly",
      "first_release_year": 1932,
      "directors": [
        "Erich von Stroheim",
        "Gregg Toland"
      ],
      "production_countries": [
        "USA"
      ],
      "source_urls": [
        "https://www.festival-lumiere.org/manifestations/queen-kelly.html",
        "https://events.webster.edu/event/queen-kelly",
        "https://www.silentera.com/video/queenKellyHV.html",
        "https://www.cinematheque.fr/media/pdf/hollywood-queen-kelly-engl.pdf",
        "https://catalog.afi.com/Film/11491-QUEEN-KELLY"
      ],
      "series": null,
      "release_note": "Bezugsfassung: 1932 in Europa veröffentlichte Kurzfassung; Frankreich 11.11.1932 laut Lumière. 1932 bezeichnet hier diese Fassung und kein abschließend geklärtes weltweites Erstjahr. Das Werk wird meist als 1929 geführt; die Cinémathèque datiert ihre Kurzfassung auf 1931. Lumière nennt eine begrenzte US-Auswertung 1929, AFI dagegen die erste kommerzielle US-Auswertung 1984 trotz eigenem Release-Feld 1929. Diese abweichenden Werk-, Fassungs- und Veröffentlichungsangaben bleiben ausdrücklich qualifiziert.",
      "director_note": "Erich von Stroheim führte die Hauptregie bis zum Abbruch 1929. Für die europäische Kurzfassung inszenierte Gregg Toland 1931 den neuen tragischen Epilog; die Cinémathèque française nennt ausdrücklich Direction of the epilogue: Gregg Toland. Sein begrenzter Ergänzungsbeitrag ist nicht mit der Hauptregie gleichzusetzen.",
      "country_note": "",
      "checked_on": "2026-10-13",
      "verification_status": "redaktionell_quellengeprueft"
    },
